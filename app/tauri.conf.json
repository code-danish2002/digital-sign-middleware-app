{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "productName": "Digital Sign App",
  "identifier": "com.railtel.digitalsign",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "./ui"
  },
  "app": {
    "windows": [
      {
        "title": "Digital Sign App",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "allowlist": {
      "all": true,
      "window": {
        "all": true
      },
      "event": {
        "all": true
      }
    }
  }
}